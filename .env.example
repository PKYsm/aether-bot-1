# ── Required ─────────────────────────────────────────────────────────────────
BOT_TOKEN=your_telegram_bot_token_here

# ── Optional ──────────────────────────────────────────────────────────────────
# Your Telegram user ID — bot will DM you on errors
OWNER_ID=your_telegram_user_id_here

# Log level: debug | info | warn | error  (default: info)
LOG_LEVEL=info

# Path to a Netscape-format cookies.txt file
# Needed for: Instagram (even public reels), Facebook private, etc.
# Export from browser using "Get cookies.txt LOCALLY" Chrome extension
# On Render: upload as a Secret File at /etc/secrets/cookies.txt
COOKIES_FILE=/etc/secrets/cookies.txt
