# ── Required ─────────────────────────────────────────────────────────────────
BOT_TOKEN=your_telegram_bot_token_here

# ── Optional ──────────────────────────────────────────────────────────────────
# Your Telegram user ID — bot will DM you on errors
OWNER_ID=your_telegram_user_id_here

# Log level: debug | info | warn | error  (default: info)
LOG_LEVEL=info
